<Window x:Class="Dockyard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dockyard Settings"
        Width="880" Height="620"
        MinWidth="760" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{StaticResource UiBase}"
            BorderBrush="#26FFFFFF" BorderThickness="1"
            CornerRadius="14"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270"
                              Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="54" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="9" Height="9" CornerRadius="2.5"
                            Background="{DynamicResource UiAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="Dockyard" Style="{StaticResource TitleText}"
                               FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="settings" Style="{StaticResource LabelText}"
                               Foreground="{StaticResource UiMuted}"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseBtn" Grid.Column="1" Content="&#x2715;"
                        Style="{StaticResource IconButton}" Margin="0,0,14,0"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- ============ body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- left rail -->
                <StackPanel Grid.Column="0" Margin="14,4,8,14">
                    <RadioButton x:Name="NavTheme" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Theme" IsChecked="True" />
                    <RadioButton x:Name="NavColours" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Colours" />
                    <RadioButton x:Name="NavLayout" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Layout" />
                    <RadioButton x:Name="NavMotion" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Motion" />
                    <RadioButton x:Name="NavBehaviour" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Behaviour" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}"
                                 GroupName="nav" Content="Apps" />

                    <Border Height="1" Background="{StaticResource UiLine}" Margin="12,14" />

                    <TextBlock Style="{StaticResource HintText}" Margin="14,0,10,0"
                               Text="Changes apply to the dock as you make them." />
                </StackPanel>

                <!-- right pane -->
                <Border Grid.Column="1" Background="{StaticResource UiPanel}"
                        CornerRadius="12,0,12,0" Margin="0,0,0,0">
                    <ScrollViewer x:Name="Scroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,10,18,24">
                        <StackPanel x:Name="PaneHost" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
