<!--
    ShowInTaskbar is deliberately True. Setting it False makes WPF create a hidden owner window and
    own this one from it, and that ownership overwrites the reparenting wallpaper mode depends on.
    WS_EX_TOOLWINDOW, applied in code, keeps the dock off the taskbar and out of Alt+Tab without
    any owner being involved.
-->
<Window x:Class="Dockyard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Dockyard.Models"
        Title="Dockyard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="Manual">

    <Window.Resources>

        <!-- ============ one launcher tile ============ -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type m:DockItem}">
            <Grid x:Name="TileRoot"
                  Background="Transparent"
                  Cursor="Hand"
                  Margin="{Binding TileMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                  RenderTransformOrigin="0.5,0.5"
                  ToolTip="{Binding Name}">

                <!-- RenderTransform is created in code, not here: WPF freezes Freezables that are
                     declared inside a template, and a frozen transform can't be animated. -->

                <StackPanel>

                    <!-- icon + hover plate + accent glow -->
                    <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                          Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}">

                        <Border x:Name="HoverPlate"
                                CornerRadius="{Binding TileCorner, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource DockTileHoverBrush}"
                                Opacity="0" />

                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Grid>

                    <!-- running/pinned accent pip -->
                    <Border x:Name="Pip"
                            Height="3" Width="3"
                            Margin="0,5,0,0"
                            CornerRadius="1.5"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource DockAccentBrush}"
                            Opacity="0" />

                    <TextBlock Text="{Binding Name}"
                               Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding LabelSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource DockTextBrush}"
                               Opacity="0.62"
                               Margin="0,4,0,0"
                               MaxWidth="{Binding LabelMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- outer grid carries the shadow margin in "none" backdrop mode -->
    <Grid>
        <Border x:Name="Root"
                Background="{DynamicResource DockBackgroundBrush}"
                BorderBrush="{DynamicResource DockBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="14"
                SnapsToDevicePixels="True">

            <Grid>
                <ItemsControl x:Name="ItemsHost"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TileTemplate}"
                              Focusable="False"
                              ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- A WrapPanel rather than a StackPanel: with Rows > 1 the code-behind
                                 constrains its extent so tiles flow onto the next line. With the
                                 default of 1 row the constraint is infinite and it behaves exactly
                                 like the old StackPanel. -->
                            <WrapPanel Orientation="{Binding DockOrientation, RelativeSource={RelativeSource AncestorType=Window}}"
                                       ClipToBounds="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- first-run hint -->
                <StackPanel x:Name="EmptyHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="24,10">
                    <TextBlock Text="Drop an app here"
                               FontSize="13"
                               Foreground="{DynamicResource DockTextBrush}"
                               Opacity="0.85"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="drag an .exe or a shortcut onto the dock"
                               FontSize="10.5"
                               Foreground="{DynamicResource DockTextBrush}"
                               Opacity="0.45"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- drop target highlight -->
                <Border x:Name="DropRing"
                        CornerRadius="14"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource DockAccentBrush}"
                        Background="Transparent"
                        Margin="-6"
                        IsHitTestVisible="False"
                        Opacity="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
